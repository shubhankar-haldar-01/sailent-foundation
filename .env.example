# =============================================================================
# Sailent Foundation — environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# Every variable below is validated at boot by @sailent/config — a missing or
# malformed value fails startup loudly rather than surfacing as a null later.
#
# Phase 1 note: variables marked [PHASE N] are declared so the schema is stable,
# but are OPTIONAL until that phase. Nothing in Phase 1 reads them.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
# development | test | staging | production — drives config strictness
APP_ENV=development

# --- Database (PostgreSQL) ---------------------------------------------------
# Decision A12: the API is a long-lived process, so this is a POOLED TCP
# connection, NOT an HTTP serverless driver. An HTTP driver cannot run the
# multi-statement donation-capture transaction.
#
# LOCAL:
# The database THIS process may open. It must agree with APP_ENV: the API and
# the worker check the pair at startup and REFUSE TO START if it is unsafe.
#
# development / test -> a local host, and one of sailent_dev, sailent_e2e,
#                       sailent_test
# production         -> the approved production host, configured in the
#                       PRODUCTION RUNTIME and never in this file
#
# Never paste a production URL here. One was, once, while APP_ENV=development:
# the API started, served, and wrote to production.
DATABASE_URL=postgresql://sailent@localhost:5432/sailent_dev
# Required for Supabase, which signs with its own root CA. Leave unset for a
# local database or any provider with a publicly-trusted certificate.
# NOTE: percent-encode the password if it contains @ : / ? # or [ ].
# Integration tests DELETE rows. They run against this instead of DATABASE_URL,
# so the application can point at a hosted database while the suites stay on a
# local throwaway one. The harness refuses a non-local target outright.
TEST_DATABASE_URL="postgres://sailent:sailent@localhost:5432/sailent_dev"
# The hosted provider's root CA. Read ONLY when the connection needs TLS, which
# a local socket does not — so local development does not need this set.
DATABASE_CA_CERT="infrastructure/certs/supabase-prod-ca-2021.crt"
#
# SUPABASE — this is the POSTGRES CONNECTION STRING, from
# Project Settings → Database → Connection string → Session pooler.
#
# NOT the same thing as NEXT_PUBLIC_SUPABASE_URL and the publishable (anon)
# key. Those two are credentials for Supabase's Data API — an HTTP service for
# supabase-js in a browser. They speak a different protocol, they cannot open a
# Postgres connection, and this platform deliberately closes that surface
# (migration 0004; see docs/supabase.md §2). The database password below is a
# separate secret and cannot be derived from the publishable key.
#
# Use the SESSION pooler (port 5432):
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# NOT port 6543. That is the TRANSACTION pooler, meant for serverless functions
# that open a connection per invocation. It does not preserve session state, so
# migrations can apply partially — `pnpm db:migrate` refuses to run over it.
#
# The direct connection (db.<ref>.supabase.co:5432) also works and is the most
# capable, but is IPv6-only on new projects unless the IPv4 add-on is enabled.

# Optional dedicated URL for migrations.
# Two uses: a role that holds DDL rights while the application role does not,
# and — on Supabase — a session-mode or direct URL when DATABASE_URL points at
# the transaction pooler.
DATABASE_MIGRATION_URL=

# Skip TLS certificate verification. Leave this alone.
# `true` encrypts the connection but does not verify who is on the other end,
# which for a connection carrying password hashes and donor PII is not a trade
# worth making. Set it only against a provider whose CA the host cannot verify,
# and fix the CA rather than leaving it set.
DATABASE_INSECURE_TLS=false

# --- Redis (Upstash in cloud, local container in development) ---------------
REDIS_URL=redis://localhost:6379
# Integration tests enqueue REAL jobs and then delete the rows those jobs refer
# to, leaving orphans a worker later drains and logs as errors. A different Redis
# database index keeps them where no worker is listening. Same server, no sharing.
TEST_REDIS_URL="redis://localhost:6379/1"

# --- Web application --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sailent Foundation
# Server-side only: where the Next.js BFF reaches the API (decision A1).
# The browser never calls this directly.
API_URL=http://localhost:4000

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated origins permitted to call the API.
# CORS is closed to browser origins in production; only the Next.js server calls it.
CORS_ORIGINS=http://localhost:3000
# Expose Swagger UI. Must be false in production.
SWAGGER_ENABLED=true

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_PORT=4001

# --- Auth [PHASE 3] ---------------------------------------------------------
# Decision A8: donor and staff tokens are separate, non-interchangeable audiences.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DONOR=30d
JWT_REFRESH_TTL_STAFF=7d
# AES-256-GCM key for donor tax-ID (PAN) encryption at rest (Phase 12).
# 32 random bytes, base64 or 64 hex characters — e.g. `openssl rand -base64 32`.
# API only. REQUIRED in production; without it locally a PAN cannot be saved.
# Losing it makes every stored PAN unreadable: keep it in the secret manager,
# backed up, and never commit it.
FIELD_ENCRYPTION_KEY=

# --- Payments — Razorpay ----------------------------------------------------
# Required in production; the API refuses to boot without all three. Optional in
# development, where the donation endpoints refuse with a clear message instead
# of the whole service failing to start.
#
# KEY_ID is the ONLY one that may reach a browser — Razorpay Checkout needs it,
# and the API hands it out with the order. The other two never leave the server.
RAZORPAY_KEY_ID=
# Signs order creation, and verifies the checkout handshake signature.
RAZORPAY_KEY_SECRET=
# Webhook signature secret. Verified as HMAC-SHA256 over the RAW request body.
# This is a SEPARATE secret from KEY_SECRET — set it in the Razorpay dashboard
# when you create the webhook, and do not reuse the key secret here.
RAZORPAY_WEBHOOK_SECRET=
# Production rejects a test key: RAZORPAY_KEY_ID must start with rzp_live_.

# --- Internal services (Phase 11) --------------------------------------------
# One shared secret, at least 32 characters, set to the SAME value for the API,
# the web server and the worker. Required in production for all three.
#   - web → API: proves the forwarded client IP (rate limits per real donor)
#   - worker → API: authorises the payment reconciliation job
# Optional locally: limits then apply per connecting address (as before), and
# reconciliation is not scheduled.
INTERNAL_API_SECRET=
# Worker only: where the worker reaches the API. Required in production.
API_INTERNAL_URL=http://localhost:4000
# Web only: the request header that carries the real client IP, and how many
# trusted proxies sit in front of the web server (for x-forwarded-for, the client
# is the address that many entries from the end). Leave unset locally.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
# Web only (Phase 12): extra origins, comma-separated, allowed to make
# state-changing requests through the web server besides the site's own origin.
# Usually unset.
TRUSTED_ORIGINS=
# Web, production (Phase 12): the web server validates its environment at start
# and refuses APP_ENV=production with FEATURE_MOCK_DATA on, without
# INTERNAL_API_SECRET or CLIENT_IP_HEADER, with a non-https NEXT_PUBLIC_APP_URL,
# or while the organisation details in apps/web/src/lib/demo-org.ts are DEMO.
# Build and start the web server with APP_ENV=production to send HSTS.

# --- Email — Brevo ----------------------------------------------------------
# Optional even in production, deliberately: a failure to send a receipt email
# must never stop a donation being recorded. Without a key the notification row
# is still written and left unsent, so the backlog is visible rather than lost.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sailent Foundation

# --- SMS / OTP [PHASE 3] ----------------------------------------------------
# Indian DLT-registered sender ID and approved templates are required.
# Vendor is open question 3 in docs/phase-0-decisions.md.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# --- Storage — Cloudflare R2 [PHASE 4] --------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=sailent-public
R2_BUCKET_PRIVATE=sailent-private
R2_PUBLIC_BASE_URL=

# --- Monitoring — Sentry ----------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Analytics [PHASE 2] ----------------------------------------------------
# Consent-gated. See docs/analytics-plan.md for the PII exclusion rules.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Feature gates ----------------------------------------------------------
# FCRA is NOT registered. Foreign contributions cannot legally be accepted.
# This gate opens only on registration. See docs/product-requirements.md §6.
FEATURE_FCRA_ENABLED=false
# Guards mock/demo data out of any deployed environment.
FEATURE_MOCK_DATA=true

# ---------------------------------------------------------------------------
# End-to-end tests
# ---------------------------------------------------------------------------
# Playwright runs its OWN api + web processes against THIS database, on its own
# ports, and never touches DATABASE_URL. Without that separation the suite
# authenticated against the staging Supabase project and re-created a staff
# account there on every run.
#
# Prepare it once:  pnpm db:prepare-e2e
E2E_DATABASE_URL=postgres://sailent:sailent@localhost:5432/sailent_e2e
# Redis DB 2. DB 0 is the application, DB 1 the API integration suites.
E2E_REDIS_URL=redis://localhost:6379/2
E2E_API_PORT=4100
E2E_WEB_PORT=3100
